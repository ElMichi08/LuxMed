# URL de login del portal LUXMED (ruta protegida, no se scrapea el login:
# el script navega hasta aqui y espera a que el propio usuario inicie sesion).
LOGIN_URL=https://ejemplo.luxmed.local/login

# TRUE/FALSE. El login es asistido: el usuario debe ver la ventana para
# poder autenticarse manualmente, por lo que HEADLESS=false es obligatorio
# mientras se hace login. Una vez logueado, el resto del flujo corre igual
# en headless o no.
HEADLESS=false

# Ruta al archivo de pacientes (xlsx). Si no existe, el script puede generar
# uno de prueba con datos falsos (ver --generate-fake-data).
PATIENTS_FILE=data/patients.xlsx

# Carpeta donde se guardan los PDF descargados y el texto extraido.
OUTPUT_DIR=output

# Formato de fecha esperado por los inputs paciente_fecha_desde / _hasta.
# [VERIFICADO EN VIVO] el input tiene data-date-format="dd-mm-yyyy" (con
# guiones, no barras); confirmado abriendo el datepicker del sitio real.
DATE_FORMAT=%d-%m-%Y

# Milisegundos que el script espera a que el usuario complete el login
# manualmente antes de continuar (10 minutos por defecto). El login se
# detecta por cambio de URL, no por un selector del home.
LOGIN_TIMEOUT_MS=600000

# Milisegundos para la navegacion inicial (page.goto) y para esperas de
# carga de pagina. Subir si el sitio es lento.
NAVIGATION_TIMEOUT_MS=60000

# Timeout generico (ms) para esperar modales/elementos.
MODAL_TIMEOUT_MS=15000
ACTION_TIMEOUT_MS=10000

# Texto de la entidad que se debe seleccionar si el archivo de pacientes
# no trae columna M (fallback). Normalmente viene del propio archivo.
DEFAULT_ENTIDAD=27 DE FEBRERO

# Entidad del perfil a usar en el modal "Mis Perfiles" (junto al rol
# "ESPECIALISTA DISTRITAL CALIDAD DE LOS SERVICIOS DE SALUD"). El sitio
# real puede tener el mismo rol repetido bajo mas de una entidad/direccion
# distrital; esto desambigua cual fila usar.
PERFIL_ENTIDAD= ROL PROFESIONAL DE SALUD

# Rango de fechas para el formulario de busqueda (paciente_fecha_desde/
# hasta), en formato DATE_FORMAT. Si se dejan vacias, se usa
# automaticamente el primer y ultimo dia del mes actual. Fijarlas cuando
# se busca la atencion de un mes especifico (cambiar segun el mes a
# procesar).
SEARCH_FECHA_DESDE=
SEARCH_FECHA_HASTA=

# Pausa fija (ms) entre cada paso del flujo, solo para validar visualmente
# en modo no-headless durante pruebas. 0 (default) no pausa nada.
STEP_PAUSE_MS=0
